{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@anthropic-ai/mcp-playwright@latest"],
      "env": {}
    },
    "21st": {
      "command": "npx",
      "args": ["-y", "@21st-dev/magic@latest"],
      "env": {
        "TWENTY_FIRST_API_KEY": "${TWENTY_FIRST_API_KEY}"
      }
    },
    "linkedin": {
      "command": "/Users/ilyaraguzov/.local/bin/uvx",
      "args": ["linkedin-scraper-mcp"]
    },
    "hh": {
      "command": "uv",
      "args": ["run", "--directory", "/Users/ilyaraguzov/Code/hh-mcp-server", "hh-mcp-server"]
    }
  }
}
